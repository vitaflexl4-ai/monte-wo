# MONTE WO — environment reference (PLACEHOLDERS ONLY — never commit real values).
#
# This file documents every variable the project reads. The web/API tier is configured in
# Cloudflare Pages (bindings + encrypted secrets), NOT from a .env file; the native release
# variables are read by Gradle / GitHub Actions. `.env` and `.env.*` are git-ignored.
# Cross-reference: docs/release/BUILD_AND_SETUP.md, docs/strength/OPERATIONS.md.

# ───────────── Cloudflare Pages / Functions (set in the Pages project, see wrangler.toml) ─────────────
# Bindings (resources, not strings):
#   DB                      D1 database  — migrations/0001_waitlist.sql then 0002_strength_index.sql
#   WORKOUT_GIFS_BUCKET     R2 bucket    — public exercise media (optional)
#   RANKING_EVIDENCE        R2 bucket    — PRIVATE performance evidence (must stay private, separate bucket)
# Variables:
TURNSTILE_SITE_KEY=0x0000000000000000000000PLACEHOLDER     # public Turnstile site key (plain variable)
RANKING_ENABLED=false                                      # keep false until infrastructure + review are ready
RANKING_ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com  # exact Access issuer, no trailing slash
RANKING_ACCESS_AUD=PASTE_ACCESS_APPLICATION_AUDIENCE_TAG   # Cloudflare Access application AUD
RANKING_PUBLISH_ENABLED=false                              # publishing of standards stays OFF by default
RANKING_APPROVED_DIGESTS=                                  # comma-separated SHA-256 of independently reviewed versions
LOCAL_DEVELOPMENT=                                         # "true" ONLY in wrangler.local.toml for local tests
AGENT_API_ENABLED=false                                    # "true" exposes /api/agent/* for operator-issued keys (server/agent.js): monitoring,
                                                           # waitlist ops, shared agent memory and the governed Strength Index as a linked
                                                           # principal. Needs migration 0004 + keys created with scripts/agent-key.mjs.
AGENT_RATE_LIMIT=                                          # requests per key per 10-minute window; empty = default 1200
NATIVE_CLIENTS_ENABLED=false                               # "true" lets the Android/iOS shells call the API (server/native.js: CORS for
                                                           # https://localhost + capacitor://localhost, header token, sign-in handoff). Needs
                                                           # migration 0003 and an Access public exception for /api/strength/native-token.
# Encrypted secrets (Pages → Settings → Variables and Secrets → Encrypt; never in Git):
TURNSTILE_SECRET=PLACEHOLDER_TURNSTILE_SECRET_KEY
RATE_LIMIT_SALT=PLACEHOLDER_RANDOM_32_BYTE_HEX

# ───────────── Native bundle (build time, scripts/build_native.py) ─────────────
NATIVE_API_ORIGIN=                                         # bare https origin of the deployed API, e.g. https://montewo.example — empty = app says
                                                           # "ranking services are not configured for this app build" (nothing is sent anywhere)

# ───────────── Android release (Gradle reads these; CI injects them from repository secrets) ─────────────
MONTE_WO_VERSION_NAME=0.1.0           # user-visible version
MONTE_WO_VERSION_CODE=1               # integer, must increase on every Play upload
ANDROID_KEYSTORE_PATH=/absolute/path/to/upload-keystore.jks   # local builds only; CI decodes ANDROID_KEYSTORE_BASE64
ANDROID_KEYSTORE_PASSWORD=PLACEHOLDER
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=PLACEHOLDER
# GitHub Actions secret names (values live only in GitHub → Settings → Secrets):
#   ANDROID_KEYSTORE_BASE64, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD

# ───────────── iOS release (account holder's machine or macOS CI; nothing read from .env) ─────────────
# Apple Team ID, signing certificate and provisioning profile are configured in Xcode
# (Signing & Capabilities) or via App Store Connect API keys — never stored in this repository.
# Bundle identifier is fixed in ios/App/App.xcodeproj (PRODUCT_BUNDLE_IDENTIFIER) = com.vitaflex.montewo
